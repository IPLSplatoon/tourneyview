{
  "name": "@tourneyview/common",
  "version": "0.10.2",
  "description": "Common tourneyview types & functionality",
  "repository": "https://github.com/IPLSplatoon/tourneyview",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "import": "./dist/index.js",
        "default": "./dist/index.iife.js"
      },
      "default": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config ../../vite.config.base.ts"
  },
  "author": "inkfarer <inkfarer@inkfarer.com>",
  "license": "MIT",
  "files": [
    "dist/**/*"
  ],
  "build": {
    "libName": "TourneyviewCommon"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "bab4fda67c55a133893f24bfa063711463126357"
}
